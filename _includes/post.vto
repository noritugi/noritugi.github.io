---
layout: base.vto
---

{{# 記事配列カウンタ #}}
{{ set allPosts = search.pages("url^=/posts/") }}
{{ set posts = [] }}

{{ for p of allPosts }}
  {{ if p.date }}
    {{ void posts.push(p) }}
  {{ /if }}
{{ /for }}

{{ void posts.sort((a, b) => a.date - b.date) }}

{{ set index = -1 }}
{{ set i = 0 }}

{{ for p of posts }}
  {{ if p.url === url }}
    {{ set index = i }}
  {{ /if }}
  {{ set i = i + 1 }}
{{ /for }}

{{ set prevPost = index > 0 ? posts[index - 1] : null }}
{{ set nextPost = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null }}

<article class="mx-auto max-w-4xl px-4 py-16" data-pagefind-body>
  <header class="mb-10">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100" data-pagefind-meta="title">
      {{ title }}
    </h1>

    <time class="text-xl text-gray-500 dark:text-gray-400 font-serif">
      {{ date.getFullYear() }}年
      {{ String(date.getMonth() + 1).padStart(2, "0") }}月
      {{ String(date.getDate()).padStart(2, "0") }}日
    </time>
  </header>

  <div class="
    prose
    prose-slate
    dark:prose-invert
    prose-h2:text-gray-900
    dark:prose-h2:text-gray-100
    prose-h3:text-gray-900
    dark:prose-h3:text-gray-100
    prose-h4:text-gray-900
    dark:prose-h4:text-gray-100
    prose-h5:text-gray-900
    dark:prose-h5:text-gray-100
    prose-h6:text-gray-900
    dark:prose-h6:text-gray-100
    prose-a:text-sky-600
    hover:prose-a:text-sky-800
    dark:prose-a:text-sky-400
    dark:hover:prose-a:text-sky-200
    max-w-none
  ">
    {{ content }}
  </div>

  <!-- 前後リンク -->
  {{ if prevPost || nextPost }}
  <nav class="mt-16 border-t border-gray-200 dark:border-gray-700 pt-8">
    <ul class="flex justify-between gap-4 text-sm">
      <li class="flex-1">
        {{ if prevPost }}
          <a
            href="{{ prevPost.url }}"
            class="block rounded border border-gray-200 p-4 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
          >
            <span class="block text-gray-500 dark:text-gray-400">前の記事</span>
            <span class="font-medium text-gray-900 dark:text-gray-100">
              {{ prevPost.title }}
            </span>
          </a>
        {{ /if }}
      </li>

      <li class="flex-1 text-right">
        {{ if nextPost }}
          <a
            href="{{ nextPost.url }}"
            class="block rounded border border-gray-200 p-4 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
          >
            <span class="block text-gray-500 dark:text-gray-400">次の記事</span>
            <span class="font-medium text-gray-900 dark:text-gray-100">
              {{ nextPost.title }}
            </span>
          </a>
        {{ /if }}
      </li>
    </ul>
  </nav>
  {{ /if }}
</article>
