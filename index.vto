---
layout: base.vto
title: Front Page
---

{{# 同年の記事をカウント #}}
{{ set posts = search.pages("url^=/posts/", "date=desc") }}

{{ set yearCounts = {} }}

{{ for post of posts }}
  {{ if post.date }}
    {{ set y = post.date.getFullYear() }}

    {{ if yearCounts[y] }}
      {{# スプレッドでオブジェクトごと再代入 #}}
      {{ set yearCounts = {
        ...yearCounts,
        [y]: yearCounts[y] + 1
      } }}
    {{ else }}
      {{ set yearCounts = {
        ...yearCounts,
        [y]: 1
      } }}
    {{ /if }}

  {{ /if }}
{{ /for }}

{{ set years = Object.keys(yearCounts).map(y => Number(y)) }}
{{ void years.sort((a, b) => b - a) }}

<section class="py-8 text-center">
  <h2 class="text-2xl font-bold mb-4">
    ログ検索
  </h2>
  <!-- Pagefind検索フォーム -->
  <div id="search" class="mx-auto max-w-xl px-4"></div>
</section>


<!-- 年フィルタ -->
<div class="mx-auto max-w-xl px-4 space-y-4 mb-8">
  <details class="group relative overflow-hidden rounded border border-gray-300 shadow-sm dark:border-gray-600" open>
    <summary
      class="flex items-center justify-between gap-2 p-3 text-gray-700 transition-colors hover:text-gray-900 dark:text-gray-200 dark:hover:text-white [&::-webkit-details-marker]:hidden">
      <span class="text-sm font-medium"> 年 </span>

      <span class="transition-transform group-open:-rotate-180">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </span>
    </summary>

    <div
      class="divide-y divide-gray-300 border-t border-gray-300 bg-white dark:divide-gray-600 dark:border-gray-600 dark:bg-gray-900">
      <fieldset class="p-3 space-y-3">
        {{ for year of years }}
        <label class="inline-flex items-center gap-3">
          <input type="checkbox"
            class="year-filter size-5 rounded border-gray-300 dark:border-gray-600 dark:bg-gray-900 dark:checked:bg-blue-600"
            value="{{ year }}" />
          <span class="text-sm font-medium text-gray-700 dark:text-gray-200">
            {{ year }}年 ({{ yearCounts[year] }})
          </span>
        </label>
        {{ /for }}
      </fieldset>
    </div>
  </details>
</div>

<!-- 記事一覧 -->
<div class="mx-auto max-w-xl px-4">
  <ol id="post-list"
    class="relative space-y-8 before:absolute before:-ml-px before:h-full before:w-0.5 before:rounded-full before:bg-gray-200 dark:before:bg-gray-700">

    {{ for post of posts }}
    {{ if post.date }}
    <li class="post-item hidden relative -ms-1.5 flex items-start gap-4" data-year="{{ post.date.getFullYear() }}">
      <span class="size-3 shrink-0 rounded-full bg-blue-600"></span>

      <div class="-mt-2">
        <time class="text-xs/none font-medium text-gray-700 dark:text-gray-300">
          {{ post.date.toLocaleDateString("ja-JP", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          }) }}
        </time>

        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">
          <a href="{{ post.url }}" class="hover:underline">
            {{ post.title }}
          </a>
        </h3>

        {{ if post.description }}
        <p class="mt-0.5 text-sm text-gray-700 dark:text-gray-100">
          {{ post.description }}
        </p>
        {{ /if }}
      </div>
    </li>
    {{ /if }}
    {{ /for }}
  </ol>

  <!-- もっと見る -->
  <div class="mt-10 text-center">
    <button
      id="load-more"
      class="rounded bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700"
    >
      もっと見る
    </button>
  </div>
</div>

<script>
  // 20件まで表示
  const PAGE_SIZE = 20;

  const checkboxes = [...document.querySelectorAll(".year-filter")];
  const items = [...document.querySelectorAll(".post-item")];
  const button = document.getElementById("load-more");

  let visibleCount = 0;

  function getSelectedYears() {
    return checkboxes
      .filter(cb => cb.checked)
      .map(cb => cb.value);
  }

  function resetView() {
    visibleCount = 0;
    items.forEach(item => item.classList.add("hidden"));
    showNext();
  }

  function showNext() {
    const selectedYears = getSelectedYears();

    const filtered = items.filter(item => {
      if (selectedYears.length === 0) return true;
      return selectedYears.includes(item.dataset.year);
    });

    const next = filtered.slice(visibleCount, visibleCount + PAGE_SIZE);
    next.forEach(el => el.classList.remove("hidden"));

    visibleCount += next.length;

    button.style.display =
      visibleCount >= filtered.length ? "none" : "";
  }

  // 初期表示
  showNext();

  // フィルタ変更時
  checkboxes.forEach(cb =>
    cb.addEventListener("change", resetView)
  );

  // もっと見る
  button.addEventListener("click", showNext);
</script>
